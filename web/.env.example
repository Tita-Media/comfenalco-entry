# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<secret-key>

# Secreto HMAC para firmar los tokens de los QR (generar: openssl rand -base64 32)
QR_TOKEN_SECRET=<secreto-aleatorio>

# URL pública del sitio (para el logo en el correo del QR)
NEXT_PUBLIC_SITE_URL=https://comfenalco-entry.vercel.app

# SMTP para el envío real del QR. Si SMTP_HOST está vacío, el envío se simula.
# Usa un servicio transaccional (Amazon SES, Resend SMTP, SendGrid, o el SMTP
# corporativo de Comfenalco). NUNCA hardcodear credenciales: solo variables de entorno.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true si el puerto es 465 (TLS implícito)
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Comfenalco <boleteria@comfenalco.com>"

# Integración VTEX (opcional): al confirmarse el pago de una orden, se crea la
# boleta y (si el evento es de envío inmediato) se genera y envía el QR.
# Si VTEX_ACCOUNT está vacío, el endpoint /api/vtex/sync no hace nada.
VTEX_ACCOUNT=            # p. ej. comfenalco
VTEX_ENVIRONMENT=vtexcommercestable
VTEX_APP_KEY=
VTEX_APP_TOKEN=
# Multi-asistente: dónde el checkout de reservas guarda los asistentes en customData.
# Si el arreglo JSON va en customApps[].fields, indica el id del app y el campo.
VTEX_RESERVA_APP_ID=    # p. ej. reservas (opcional; si vacío, escanea todos los customApps)
VTEX_RESERVA_FIELD=     # p. ej. asistentes (opcional; si vacío, prueba todos los campos)
# Secreto que Vercel Cron envía como Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
