# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Secreto HMAC para firmar los tokens de los QR (generar: openssl rand -base64 32)
QR_TOKEN_SECRET=<secreto-aleatorio>

# SMTP opcional para envío real de boletas. Si SMTP_HOST está vacío,
# el envío se simula (marca email_sent_at sin enviar).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Boletería <boleteria@example.com>"
